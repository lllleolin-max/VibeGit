{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@vibegit/shared": ["./packages/shared/src/index.ts"],
      "@vibegit/git-engine": ["./packages/git-engine/src/index.ts"],
      "@vibegit/database": ["./packages/database/src/index.ts"],
      "@vibegit/checkpoint-engine": ["./packages/checkpoint-engine/src/index.ts"],
      "@vibegit/agent-events": ["./packages/agent-events/src/index.ts"],
      "@vibegit/github-provider": ["./packages/github-provider/src/index.ts"],
      "@vibegit/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "scripts", "tests", "electron.vite.config.ts", "vitest.config.ts", "eslint.config.js"]
}
